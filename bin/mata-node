#!/usr/bin/env php
<?php

declare(strict_types=1);

use Mata\Cli\CliApplication;
use Mata\Cli\Command\ConfigValidateCommand;
use Mata\Cli\Command\LogTestCommand;
use Mata\Config\Validation\NodeConfigValidator;
use Mata\Utils\PathResolver;
use Symfony\Component\Console\Input\ArgvInput;

require_once __DIR__ . '/../vendor/autoload.php';

if (PHP_SAPI !== 'cli') {
    exit(1);
}

// Root reads files the web server cannot, so its results would not hold for the node.
if (function_exists('posix_geteuid') && posix_geteuid() === 0 && getenv('MATA_ALLOW_ROOT') !== '1') {
    fwrite(STDERR, "Refusing to run as root. Run as the web server user, e.g.\n"
        . "  make mata ARGS=\"config validate\"   (Docker)\n"
        . "  sudo -u www-data php bin/mata-node …   (http on Arch, apache on RHEL)\n"
        . "Set MATA_ALLOW_ROOT=1 to override.\n");

    exit(2);
}

$paths = PathResolver::fromEntryPoint(__FILE__);

$application = new CliApplication();
$application->addCommands([
    new ConfigValidateCommand(new NodeConfigValidator(), $paths),
    new LogTestCommand($paths),
]);

$argv = $_SERVER['argv'];

// Accept `mata-node config validate` as well as Symfony's `mata-node config:validate`.
if (isset($argv[1], $argv[2]) && $application->has("{$argv[1]}:{$argv[2]}")) {
    array_splice($argv, 1, 2, ["{$argv[1]}:{$argv[2]}"]);
}

exit($application->run(new ArgvInput($argv)));

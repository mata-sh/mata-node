{
    "example-app-server-a": {
        "title": "Example Application",
        "url": "https://example.com/app",
        "path": "example-app",
        "disabled": "false",
        "ping": "on",
        "readme": "example-app/README.md",
        "alarms_enabled": "off",
        "sessions": {
            "type": "file",
            "path": "example-app/temp/sessions",
            "filename_regex": ""
        },
        "logs": [
            {
                "type": "php_error_log",
                "paths": [
                    "example-app/logs/error.log"
                ]
            },
            {
                "type": "monolog",
                "paths": [
                    "example-app/logs/app.log",
                    "example-app/logs/debug.log"
                ]
            }
        ],
        "description": "Full-featured example with file sessions and parser-specific log groups",
        "composer": {
            "json": "example-app/composer.json",
            "lock": "example-app/composer.lock",
            "bin": "example-app/composer.phar"
        },
        "env": "live",
        "status_endpoint": "https://example.com/app/health/"
    },
    "redis-sessions-app": {
        "title": "Redis Session Application",
        "url": "https://example.com/redis-sessions",
        "path": "redis-sessions-app",
        "ping": "on",
        "sessions": {
            "type": "redis",
            "dsn_env": "REDIS_SESSION_DSN",
            "prefix": "PHPREDIS_SESSION:",
            "count_key": "mata:sessions:redis-sessions-app:count",
            "scan_count": 1000,
            "timeout_seconds": 1.0,
            "cache_ttl_seconds": 60
        },
        "logs": [
            "redis-sessions-app/logs/error.log"
        ],
        "description": "Redis sessions using low-stress count_key counting. The app must maintain the count_key value.",
        "env": "live"
    },
    "minimal-app": {
        "title": "Minimal Application",
        "url": "https://example.com/minimal",
        "path": "minimal-app",
        "logs": [
            "minimal-app/logs/error.log"
        ],
        "description": "Old format (simple array) - uses auto-detection",
        "env": "live"
    },
    "auto-detect-app": {
        "title": "Auto-detect Log Format",
        "url": "https://example.com/autodetect",
        "path": "autodetect-app",
        "logs": [
            {
                "paths": [
                    "autodetect-app/logs/error.log",
                    "autodetect-app/logs/app.log"
                ]
            }
        ],
        "description": "New format without type specified - uses auto-detection",
        "env": "live"
    },
    "mixed-logs-app": {
        "title": "Mixed Log Types",
        "url": "https://example.com/mixed",
        "path": "mixed-app",
        "logs": [
            {
                "type": "json",
                "paths": [
                    "mixed-app/logs/structured.log"
                ]
            },
            {
                "type": "monolog",
                "paths": [
                    "mixed-app/logs/application.log"
                ]
            },
            {
                "paths": [
                    "mixed-app/logs/legacy.log"
                ]
            }
        ],
        "description": "Multiple log groups with different parsers + auto-detect",
        "env": "live"
    },
    "composer-enabled": {
        "title": "Composer Auto-detect",
        "url": "https://example.com/composer",
        "path": "composer-app",
        "logs": [
            "composer-app/logs/error.log"
        ],
        "composer": {
            "enabled": true
        },
        "description": "Composer uses composer.json and composer.lock in the application path",
        "env": "live"
    }
}

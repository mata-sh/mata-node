# ========================================
# MATA Dashboard Configuration
# ========================================
# Copy this file to config.env and update with your actual values
# DO NOT commit config.env to version control

# ========================================
# Application Environment
# ========================================
# Environment type: demo, dev, prod (production)
# demo: Uses MockServerDataCollector with demo data
# dev: Development environment with debug settings
# prod: Production environment (default, recommended)
APP_ENV=prod

# Domain configuration
DOMAIN="your-domain.com"
DIR=

# ========================================
# Application Settings
# ========================================
# Enable/disable maintenance mode (ON/OFF)
MAINTENANCE_MODE_ENABLED=OFF

# IP whitelisting for login protection (ON/OFF)
# When enabled, only IPs in ALLOWED_IPS can access the login page
# Useful for enterprise environments with static IPs
IP_WHITELIST_ENABLED=OFF
ALLOWED_IPS=127.0.0.1,::1

# ========================================
# PHP Runtime Settings
# ========================================
# Display PHP errors (1/0) - should be 0 in production
DISPLAY_ERRORS=1

# PHP error log level: notices, warnings, errors
LOG_LEVEL=notices

# ========================================
# Application Logging
# ========================================
# Application log file path (relative to app root or absolute)
APP_LOG_PATH=logs/app.log

# Monolog level: debug, info, notice, warning, error, critical, alert, emergency
MONOLOG_LEVEL=debug

# ========================================
# Rate Limiting
# ========================================
# Enable/disable rate limiting globally (ON/OFF)
RATE_LIMIT_ENABLED=ON

# Rate limiting storage backend: file, redis
# file: Store rate limit data in filesystem (default, no dependencies)
# redis: Store rate limit data in Redis (requires Redis server)
RATE_LIMIT_STORAGE=file

# File storage path for rate limiting (only used if RATE_LIMIT_STORAGE=file)
# Leave empty to use default: sys_get_temp_dir()/cache/rate_limit
RATE_LIMIT_FILE_PATH=

# Redis connection settings (only used if RATE_LIMIT_STORAGE=redis)
RATE_LIMIT_REDIS_HOST=127.0.0.1
RATE_LIMIT_REDIS_PORT=6379
RATE_LIMIT_REDIS_PASSWORD=
RATE_LIMIT_REDIS_DATABASE=0

# Rate limits per route group
# Login routes (/login, /logout) - Stricter limits to prevent brute force attacks
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Dashboard and watch routes (/watch/*) - Moderate limits for authenticated users
RATE_LIMIT_DASHBOARD_MAX_REQUESTS=100
RATE_LIMIT_DASHBOARD_WINDOW_SECONDS=60

# API metrics routes (/api/metrics/*) - Higher limits for data-heavy endpoints
RATE_LIMIT_API_MAX_REQUESTS=200
RATE_LIMIT_API_WINDOW_SECONDS=60

# ========================================
# MATA Node configuration
# ========================================
# Copy to config/config.env (make bootstrap-config does this) and set the dashboard
# values. Keep config.env out of version control.
#
# Invalid values stop the node from starting; docs/configuration.md lists what each key
# accepts. Relative paths resolve against the node directory.

# ========================================
# Dashboard authentication (required)
# ========================================
# This node's key in the dashboard's servers.json and servers.secrets.json. Renaming it in
# the dashboard breaks authentication until this value is updated too.
DASHBOARD_SERVER_ID=prod-web-01

# Shared HMAC secret: the api_key stored under this node's key in the dashboard's
# servers.secrets.json (servers.json up to dashboard 0.8.0). It is never sent; requests
# carry a signed X-Mata-Auth header.
DASHBOARD_API_KEY=

# Accepted clock difference between dashboard and node, in seconds
DASHBOARD_CLOCK_SKEW_WINDOW=120

# ========================================
# Access control
# ========================================
# ON answers every route except /health with 503
MAINTENANCE_MODE_ENABLED=OFF

# ON restricts authenticated routes to the IPs and CIDRs in ALLOWED_IPS
IP_WHITELIST_ENABLED=OFF
ALLOWED_IPS=127.0.0.1,::1

# Reverse proxies whose X-Forwarded-For header is trusted; otherwise the client IP is
# REMOTE_ADDR. Never list a proxy you do not control.
TRUSTED_PROXIES=

# ========================================
# Logging and paths
# ========================================
# debug, info, notice, warning, error, critical, alert or emergency
MONOLOG_LEVEL=debug
APP_LOG_PATH=logs/app.log

# Runtime and cache files; empty uses temp/
TEMP_DIR=

# ========================================
# Rate limiting (per client IP)
# ========================================
RATE_LIMIT_ENABLED=ON

# file, apcu (shared memory; the Docker images include the extension) or redis (needs a
# Redis server and the redis PHP extension, which the Docker images do not include)
RATE_LIMIT_STORAGE=file

# Directory for file storage; empty uses <system temp dir>/cache/rate_limit
RATE_LIMIT_FILE_PATH=

# Connection for redis storage
RATE_LIMIT_REDIS_HOST=127.0.0.1
RATE_LIMIT_REDIS_PORT=6379
RATE_LIMIT_REDIS_PASSWORD=
RATE_LIMIT_REDIS_DATABASE=0

# Requests allowed on authenticated routes per window
RATE_LIMIT_API_MAX_REQUESTS=200
RATE_LIMIT_API_WINDOW_SECONDS=60

# Failed authentications allowed per window; over the limit the IP gets 429, even with
# valid credentials, until the window passes
RATE_LIMIT_AUTH_FAILED_MAX_REQUESTS=10
RATE_LIMIT_AUTH_FAILED_WINDOW_SECONDS=300

# ========================================
# Composer audits
# ========================================
# Node-wide defaults; composer.bin and composer.php_bin per app in apps.json override them.
# Composer executable; empty uses composer from PATH
COMPOSER_BIN=

# PHP CLI binary for running a composer.phar, e.g. /usr/bin/php8.3-cli where php is not
# the CLI binary; empty uses php
COMPOSER_PHP_BIN=

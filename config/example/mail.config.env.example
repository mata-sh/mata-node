# ========================================
# MATA Dashboard - Email Configuration
# ========================================
# Copy this file to mail.config.env and update with your actual values
# DO NOT commit mail.config.env to version control

# ========================================
# Email Recipients
# ========================================
# Comma-separated list of email addresses

# Test email recipients (for testing email functionality)
MAIL_TEST_RECIPIENTS="admin@your-domain.com"

# Alert recipients (for monitoring alerts and notifications)
MAIL_ALERT_RECIPIENTS="alerts@your-domain.com"

# Development team recipients (for development notifications)
MAIL_DEV_RECIPIENTS="dev-team@your-domain.com"

# ========================================
# Symfony Mailer Configuration
# ========================================
# Recommended for production use

# Symfony Mailer DSN format examples:
# SMTP: smtp://username:password@smtp.example.com:587
# Gmail: gmail://username:password@default
# SendGrid: sendgrid://api_key@default
# Postmark: postmark://token@default

SYM_MAILER_DSN="smtp://your_smtp_user:your_smtp_password@smtp.your-provider.com:587"
SYM_FROM_EMAIL="noreply@your-domain.com"
SYM_FROM_NAME="MATA Dashboard"

# ========================================
# Email Settings
# ========================================
# Global email configuration

# Character encoding for emails
MAIL_CHARSET=utf-8

# Word wrap length for email content
MAIL_WORD_WRAP=75

# ========================================
# Email Templates
# ========================================
# Email template configuration

# Enable HTML emails (true/false)
MAIL_HTML_ENABLED=true

# Default email language/locale
MAIL_LOCALE=en_US

# ========================================
# Email Security
# ========================================
# Email security settings

# Enable email encryption (true/false)
MAIL_ENCRYPTION_ENABLED=true

# Email rate limiting (emails per minute)
MAIL_RATE_LIMIT=10

# ========================================
# Development Settings
# ========================================
# Development-specific email settings

# Log all emails to file instead of sending (true/false) - useful for development
MAIL_LOG_ONLY=false

# Development email override (all emails go here if set)
# MAIL_DEV_OVERRIDE=dev@your-domain.com
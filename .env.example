# MATA Node - Docker Environment Variables
# Copy this file to .env and customize for your environment

# ========================================
# Environment Configuration
# ========================================
# Application environment: dev, demo, or prod
# This is set here (not in config.env) because Docker Compose needs it
# to select the correct docker-compose override file
APP_ENV=dev

# ============================================================
# Docker Compose Configuration
# ============================================================

# Project name prefix for container names
COMPOSE_PROJECT_NAME=mata-node

# Web server port (maps to container port 80)
# Using non-standard port to avoid conflicts with common services
WEB_PORT=3310

# PHP version to use in Docker images
# Production: Pin to specific patch version for reproducible builds (e.g., 8.3.14)
# Development: Can use minor version for latest patches (e.g., 8.3)
PHP_VERSION=8.3.14

# Composer version to use in Docker images
# Production: Pin to specific version for reproducible builds (e.g., 2.7.9)
# Development: Can use 'latest' for newest version
COMPOSER_VERSION=2.7.9

# ============================================================
# Optional Application Environment Overrides
# ============================================================
# These override settings from config/*.env files if needed
# Uncomment and set as needed

# Application domain (if different from config/config.env)
# DOMAIN=your-domain.com

# Base directory path (if different from config/config.env)
# DIR=/custom/path

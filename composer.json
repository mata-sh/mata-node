{
    "name": "mata/mata-node",
    "description": "Mata Monitoring Tool",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "XarcDev",
            "email": "mata@xarc.dev"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "symfony/mailer": "^7.2",
        "bramus/router": "^1.6",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "mata-sh/rate-limiter": "dev-main",
        "monolog/monolog": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.3"
        }
    },
    "autoload": {
        "psr-4": {
            "Mata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mata\\Tests\\": "src/Tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ],
        "lint": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=512M --level=5",
        "test": "./vendor/bin/phpunit --colors=always",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    }
}

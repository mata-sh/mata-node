{
    "name": "mata/mata-node",
    "description": "Lightweight, stateless agent for MATA Dashboard: exposes read-only, HMAC-authenticated JSON endpoints for server, application, log and database health.",
    "type": "project",
    "keywords": [
        "monitoring",
        "agent",
        "server-monitoring",
        "shared-hosting",
        "health-check"
    ],
    "homepage": "https://mata.sh",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "XarcDev",
            "email": "mata@xarc.dev"
        }
    ],
    "support": {
        "email": "mata@xarc.dev",
        "docs": "https://github.com/mata-sh/mata-node/tree/main/docs",
        "issues": "https://github.com/mata-sh/mata-node/issues",
        "source": "https://github.com/mata-sh/mata-node",
        "security": "https://github.com/mata-sh/mata-node/blob/main/SECURITY.md"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "symfony/mailer": "^7.2",
        "bramus/router": "^1.6",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "mata-sh/rate-limiter": "^2.0",
        "monolog/monolog": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "cyclonedx/cyclonedx-php-composer": "^6.0"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "cyclonedx/cyclonedx-php-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Mata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mata\\Tests\\": "src/Tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ],
        "lint": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=512M --level=5",
        "test": "./vendor/bin/phpunit --colors=always",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    }
}

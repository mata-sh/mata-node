{
    "name": "symfony/skeleton",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "symfony/console": "7.1.*",
        "symfony/dotenv": "7.1.*",
        "symfony/framework-bundle": "7.1.*",
        "symfony/runtime": "7.1.*",
        "symfony/yaml": "7.1.*"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.1.*"
        }
    }
}
